# Copie ce fichier en ".env" et remplis les valeurs.
# Ne partage jamais le fichier .env et ne l'envoie pas sur GitHub.

# --- Venice (génération d'images) ---
NUXT_VENICE_API_KEY=
NUXT_VENICE_MODEL=qwen-image-2-edit
# Si ce modèle n'existe pas sur ton compte, remets : NUXT_VENICE_MODEL=firered-image-edit

# --- Sessions de connexion ---
# Une phrase secrète d'au moins 32 caractères (n'importe quoi de long et aléatoire)
NUXT_SESSION_PASSWORD=

# --- Stripe (achat de crédits) ---
# Clé secrète : Stripe > Développeurs > Clés API (commence par sk_test_ en test, sk_live_ en réel)
NUXT_STRIPE_SECRET_KEY=
# Secret du webhook : Stripe > Développeurs > Webhooks (commence par whsec_)
NUXT_STRIPE_WEBHOOK_SECRET=

# --- Connexion Google (optionnel) ---
NUXT_PUBLIC_GOOGLE_LOGIN=false
NUXT_OAUTH_GOOGLE_CLIENT_ID=
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=
